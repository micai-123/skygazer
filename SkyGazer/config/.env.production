# SkyGazer 生产环境配置
# 复制此文件为 .env.production.local 并填入实际值

# ==================== 数据库配置 ====================
DB_USERNAME=root
DB_PASSWORD=SkyGazer@2026!Secure

# ==================== Redis配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT配置 ====================
# 生产环境请使用强随机字符串（至少 32 位）
JWT_SECRET=skygazer-prod-secret-key-2026-must-be-at-least-256-bits-secure-random

# ==================== 通义千问 API 配置 ====================
# 获取地址：https://dashscope.console.aliyun.com/
OPENAI_API_KEY=sk-b91c0e491a81449697ea9b78eb7363c6
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# AI 模型配置
AI_MODEL=qwen-plus
AI_VISION_MODEL=qwen-vl-plus
AI_EMBEDDING_MODEL=text-embedding-v3

# ==================== 和风天气 API 配置 ====================
# 获取地址：https://dev.qweather.com/
QWEATHER_API_KEY=d1f5b123e92c468a86a08826cf9d8fc6
QWEATHER_BASE_URL=https://mv33jqaeug.re.qweatherapi.com/v7
QWEATHER_GEO_URL=https://mv33jqaeug.re.qweatherapi.com/geo/v2

# ==================== 应用环境 ====================
SPRING_PROFILES_ACTIVE=prod

# ==================== 服务器配置 ====================
# 服务器公网 IP 或域名（用于前端 API 代理配置）
SERVER_HOST=0.0.0.0
SERVER_PORT=80
